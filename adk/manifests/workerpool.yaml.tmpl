# Worker Pods for the ADK track. Same shape as modules/02-hello-actor/manifests/workerpool.yaml.tmpl,
# with a label of its own (workload=adk-agent) and more memory per worker: a Python ADK server
# with the google-genai client and its tools idles at a few hundred MiB, where the Go agent of
# the core modules uses a few MiB. Replicas are the active-actor ceiling; suspended actors do
# not occupy a worker.
apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: adk-agents
  namespace: ${NAMESPACE}
  labels:
    workload: adk-agent
spec:
  # Scale later with: kubectl -n ${NAMESPACE} patch workerpool adk-agents --type merge -p '{"spec":{"replicas":4}}'
  replicas: 2
  workerImage: ${WORKER_IMAGE}
  sandboxClasses:
  - name: gvisor
    configRef:
      name: gvisor-default
  template:
    labels:
      workload: adk-agent
    resources:
      limits:
        cpu: "2"
        memory: 2Gi
      requests:
        cpu: 500m
        memory: 2Gi
