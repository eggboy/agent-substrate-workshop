# ActorTemplate adk-vertex-v1: approach B. Same image and agent as adk-v1; the only change is
# where the google-genai client sends its Developer-API calls: the gateway's /genai proxy,
# which serves them on Vertex AI with the gateway's Workload Identity. GOOGLE_API_KEY stays a
# placeholder because the client insists on one; its header is overwritten by the egress
# gateway with the actor's JWT (adk/manifests/egress-adk-vertex.yaml), which the gateway logs
# per request. The actor needs no trust bundle: nothing it talks to is HTTPS.
metadata:
  atespace: ${ATESPACE}
  name: adk-vertex-v1
workerSelector:
  matchLabels:
    workload: adk-agent
containers:
- name: agent
  image: ${ADK_IMAGE}
  command: ["/app/.venv/bin/python", "-m", "shim.entrypoint"]
  env:
  - name: ADK_EXTRA_ARGS
    value: "--session_service_uri=memory:// --auto_create_session"
  - name: AGENT_MODEL
    value: ${GEMINI_MODEL}
  - name: GOOGLE_API_KEY
    value: placeholder-replaced-by-egress-gateway
  - name: GOOGLE_GEMINI_BASE_URL
    value: http://gateway.${NAMESPACE}.svc.cluster.local/genai
  - name: ACTOR_SUSPEND_URL
    value: http://gateway.${NAMESPACE}.svc.cluster.local/actors/{actor}/suspend
  wakeupProbe:
    httpGet: {path: /health, port: 80}
  volumeMounts:
  - {name: workspace, mountPath: /workspace}
  - {name: system-info, mountPath: /run/ate}
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 1610612736
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
- name: workspace
  durableDir: {}
- name: system-info
  systemInfo:
    dataSources:
    - actorMetadata:
        items:
        - field: ACTOR_METADATA_FIELD_NAME
          path: actor-name
        - field: ACTOR_METADATA_FIELD_ATESPACE
          path: atespace
        - field: ACTOR_METADATA_FIELD_UID
          path: actor-uid
